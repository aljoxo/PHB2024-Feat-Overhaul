function FeatRequirementTwoAbilitiesGreaterEqual(ability1, ability2, value)
	if ability1 == "Strength" then
		score1 = context.Source.Strength
	elseif ability1 == "Dexterity" then
		score1 = context.Source.Dexterity
	elseif ability1 == "Constitution" then
		score1 = context.Source.Constitution
	elseif ability1 == "Intelligence" then
		score1 = context.Source.Intelligence
	elseif ability1 == "Wisdom" then
		score1 = context.Source.Wisdom
	elseif ability1 == "Charisma" then
		score1 = context.Source.Charisma
	else
		return ConditionResult(false)
	end

	if ability2 == "Strength" then
		score2 = context.Source.Strength
	elseif ability2 == "Dexterity" then
		score2 = context.Source.Dexterity
	elseif ability2 == "Constitution" then
		score2 = context.Source.Constitution
	elseif ability2 == "Intelligence" then
		score2 = context.Source.Intelligence
	elseif ability2 == "Wisdom" then
		score2 = context.Source.Wisdom
	elseif ability2 == "Charisma" then
		score2 = context.Source.Charisma
	else
		return ConditionResult(false)
	end

	return ConditionResult(ability1 >= value or ability2 >= value)
end

-- function was originally written by Cahoot in Feat Overhaul
function APO_DDIsFlatValueInterruptInteresting(max, entity)
    local entity = entity or context.Target
    local max = max or 0
    if context.InterruptedRoll.RollCritical ~= RollCritical.None then
        return ConditionResult(false, {ConditionError("IsCriticalFailSuccess")})
    end
    
    local rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    local result = rollSuccess and ((context.InterruptedRoll.Total - context.InterruptedRoll.Difficulty) < max)
    return ConditionResult(result)
end